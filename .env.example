# ------------------------------------------------------------------
# FinanceZap — variáveis de ambiente (exemplo, sem credenciais reais)
# Copie para .env e preencha. Nunca versione o .env.
# ------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=FinanceZap
DEFAULT_TIMEZONE=America/Sao_Paulo

# Segredo para HMAC de sessões e códigos (gere com: openssl rand -hex 32)
APP_SECRET=troque-por-um-segredo-aleatorio-de-64-caracteres

DATABASE_URL=postgres://financezap:financezap@localhost:5432/financezap
REDIS_URL=redis://127.0.0.1:6379

# --- WhatsApp Cloud API (Meta) -------------------------------------
# Meta for Developers > seu app > WhatsApp > Configuração da API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta for Developers > Configurações do app > Básico > Chave secreta do app
WHATSAPP_APP_SECRET=
# Valor que você inventa e cola também na configuração do webhook da Meta
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
# Número comercial no formato internacional sem "+" (usado no link wa.me)
WHATSAPP_BUSINESS_NUMBER=
# true = não envia nada à Meta, só registra (útil em desenvolvimento)
WHATSAPP_DRY_RUN=false
# Custo estimado por mensagem de serviço (USD) para o painel de custos.
# Consulte a tabela vigente da Meta para o Brasil.
WHATSAPP_COST_PER_SERVICE_MESSAGE_USD=0

# --- OpenAI ---------------------------------------------------------
OPENAI_API_KEY=
# Precisa suportar Structured Outputs (json_schema strict)
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=20000
# Preço do modelo escolhido (USD por 1M tokens) — confira na página de preços da OpenAI
OPENAI_PRICE_INPUT_PER_M=0.4
OPENAI_PRICE_OUTPUT_PER_M=1.6
USD_BRL_RATE=5.5

# --- Asaas ----------------------------------------------------------
# Sandbox: https://api-sandbox.asaas.com/v3  |  Produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# Token que você define ao cadastrar o webhook no Asaas (32+ caracteres)
ASAAS_WEBHOOK_TOKEN=
BILLING_GRACE_DAYS=5

# --- Proprietário (usado só pelo `npm run db:seed`) -----------------
OWNER_EMAIL=
OWNER_PASSWORD=
